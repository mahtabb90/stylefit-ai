# ==============================
# DATA
# ==============================

data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

*.json.gz
*.csv
*.parquet

# Model-comparison summaries are intentional versioned report artifacts.
!reports/model_comparison/*.csv

# ==============================
# TRAINED MODELS
# ==============================

models/*
!models/.gitkeep

*.joblib
*.pkl
*.pickle
*.keras
*.h5
*.onnx

# ==============================
# PYTHON
# ==============================

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

.venv/
venv/
env/

# ==============================
# ENVIRONMENT VARIABLES
# ==============================

.env
.env.*
!.env.example

# ==============================
# FRONTEND
# ==============================

node_modules/
dist/
build/
.vite/

# ==============================
# IDE AND OPERATING SYSTEM
# ==============================

.vscode/
.idea/
.DS_Store
Thumbs.db

